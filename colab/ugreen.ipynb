import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
import seaborn as sns

# ============================== 
# Configuración inicial 
# ============================== 

# Nombre del archivo CSV que contiene los datos de los sensores. 
CSV_FILE = "history.csv"
# Tamaño de la ventana para el cálculo de la media móvil, usado para suavizar los datos. 
SMOOTH_WINDOW = 11

# ============================== 
# Leer y preparar datos 
# ============================== 

# Carga el archivo CSV en un DataFrame de pandas. 
df = pd.read_csv(CSV_FILE)

# Filtra el DataFrame para obtener los datos del sensor de temperatura de la CPU. 
temp = df[df["entity_id"] == "sensor.ugreen_nas_cpu_temperature"].copy()
# Filtra el DataFrame para obtener los datos del sensor de potencia. 
pot = df[df["entity_id"] == "sensor.fritz_dect_200_1_potencia"].copy()

# Convierte la columna 'last_changed' de temperatura a formato datetime y la ajusta a la zona horaria de Madrid. 
temp["last_changed"] = (
    pd.to_datetime(temp["last_changed"], utc=True)
      .dt.tz_convert("Europe/Madrid")
)

# Convierte la columna 'last_changed' de potencia a formato datetime y la ajusta a la zona horaria de Madrid. 
pot["last_changed"] = (
    pd.to_datetime(pot["last_changed"], utc=True)
      .dt.tz_convert("Europe/Madrid")
)

# Convierte la columna 'state' de temperatura a valores numéricos, manejando errores. 
temp["state"] = pd.to_numeric(temp["state"], errors="coerce")
# Convierte la columna 'state' de potencia a valores numéricos, manejando errores. 
pot["state"] = pd.to_numeric(pot["state"], errors="coerce")

# Ordena los DataFrames por la columna de fecha y hora. 
temp = temp.sort_values("last_changed")
pot = pot.sort_values("last_changed")

# ============================== 
# Fusionar ambas series de tiempo 
# ============================== 

# Realiza una fusión 'asof' para combinar los DataFrames de temperatura y potencia, 
# emparejando por la fecha más cercana. Los sufijos ayudan a distinguir las columnas. 
merged = pd.merge_asof(
    temp,
    pot,
    on="last_changed",
    direction="nearest",
    suffixes=('_temp', '_pot')
)

# ============================== 
# Calcular medias móviles 
# ============================== 

# Calcula la media móvil de la temperatura de la CPU y la guarda en una nueva columna. 
merged["cpu_temp"] = (
    merged["state_temp"]
    .rolling(SMOOTH_WINDOW, min_periods=1)
    .mean()
)

# Calcula la media móvil de la potencia y la guarda en una nueva columna. 
merged["potencia"] = (
    merged["state_pot"]
    .rolling(SMOOTH_WINDOW, min_periods=1)
    .mean()
)

# ============================== 
# Calcular correlación 
# ============================== 

correlation = merged['cpu_temp'].corr(merged['potencia'])
print(f"Correlación entre la temperatura de la CPU y la potencia: {correlation:.2f}")

# ============================== 
# Generar Gráfico 1: Temperatura CPU y Potencia vs Tiempo 
# ============================== 

# Crea una figura y un eje para el gráfico, especificando tamaño y DPI. 
fig1, ax1 = plt.subplots(figsize=(8.53, 4.80), dpi=300)

# Grafica la temperatura de la CPU en el eje primario (ax1). 
ax1.plot(
    merged["last_changed"],
    merged["cpu_temp"],
    color="firebrick",
    linewidth=2,
    label="Temperatura CPU (°C)"
)

# Configura la etiqueta y el color del eje Y izquierdo para la temperatura. 
ax1.set_ylabel(
    "Temperatura CPU (°C)",
    color="firebrick",
    fontsize=12
)
ax1.tick_params(axis="y", colors="red")

# Crea un segundo eje Y (ax2) que comparte el mismo eje X que ax1, para la potencia. 
ax2 = ax1.twinx()

# Grafica la potencia en el eje secundario (ax2). 
ax2.plot(
    merged["last_changed"],
    merged["potencia"],
    color="royalblue",
    linewidth=2,
    label="Potencia (W)"
)

# Configura la etiqueta y el color del eje Y derecho para la potencia. 
ax2.set_ylabel(
    "Potencia (W)",
    color="royalblue",
    fontsize=12
)
ax2.tick_params(axis="y", colors="royalblue")

# Establece la etiqueta del eje X. 
ax1.set_xlabel("Hora", fontsize=12)

# Configura los localizadores principales del eje X para mostrar las horas. 
ax1.xaxis.set_major_locator(mdates.HourLocator())

# Formatea las etiquetas del eje X para mostrar solo la hora y los minutos. 
ax1.xaxis.set_major_formatter(
    mdates.DateFormatter("%H:%M")
)

# Ajusta automáticamente el formato de las fechas en el eje X para evitar solapamientos. 
fig1.autofmt_xdate(rotation=0)

# Establece el título principal del gráfico. 
plt.title(
    "Temperatura CPU y potencia consumida vs tiempo",
    fontsize=14,
    fontweight="bold"
)

# Añade una cuadrícula al eje principal para mejor legibilidad. 
ax1.grid(
    True,
    linestyle="--",
    alpha=0.65
)

# Obtiene los manejadores y etiquetas de la leyenda para ambos ejes. 
l1, lab1 = ax1.get_legend_handles_labels()
l2, lab2 = ax2.get_legend_handles_labels()

# Combina y muestra las leyendas en una posición específica, con un fondo visible. 
ax1.legend(
    l1 + l2,
    lab1 + lab2,
    bbox_to_anchor=(0.57, 0.28),
    frameon=True,
    framealpha=0.90,
    facecolor="white"
)

# Elimina el espacio en blanco extra en los márgenes horizontales. 
ax1.margins(x=0)

# Ajusta automáticamente los parámetros de la subtrama para un diseño apretado. 
plt.tight_layout()

# Guarda la figura en un archivo PNG. 
plt.savefig(
    "figura1.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()

# ============================== 
# Generar Gráfico 2: Correlación entre Temperatura CPU y Potencia 
# ============================== 

# Crear un gráfico de dispersión con la recta de ajuste 
fig2, ax = plt.subplots(figsize=(10, 6))
sns.regplot(
    x='cpu_temp',
    y='potencia',
    data=merged,
    scatter_kws={'facecolors': 'none', 'edgecolors': 'darkblue', 's': 50},
    line_kws={'color': 'red'},
    ax=ax
)
plt.title('Correlación entre Temperatura CPU y Potencia con Recta de Ajuste')
plt.xlabel('Temperatura CPU (°C)')
plt.ylabel('Potencia (W)')
plt.grid(True, linestyle='--', alpha=0.7)

# Obtener los valores máximos calculados previamente 
max_temp_row = merged.loc[merged['cpu_temp'].idxmax()]
max_temp_x = max_temp_row['cpu_temp']

max_pot_row = merged.loc[merged['potencia'].idxmax()]
max_pot_y = max_pot_row['potencia'] # Utilizar el valor de potencia máxima de la fila 

# Añadir línea horizontal discontinua para la potencia máxima 
ax.axhline(y=max_pot_y, color='royalblue', linestyle='--', linewidth=1.0)

# Añadir línea vertical discontinua para la temperatura máxima 
ax.axvline(x=max_temp_x, color='firebrick', linestyle='--', linewidth=1.0)

# Añadir texto para el valor máximo de potencia 
ax.text(ax.get_xlim()[0] + 0.01 * (ax.get_xlim()[1] - ax.get_xlim()[0]),
        max_pot_y + 0.01 * (ax.get_ylim()[1] - ax.get_ylim()[0]),
        f'{max_pot_y:.1f}W',
        color='royalblue', ha='left', va='bottom', fontsize=10)

# Añadir texto para el valor máximo de temperatura 
ax.text(max_temp_x + 0.01 * (ax.get_xlim()[1] - ax.get_xlim()[0]),
        ax.get_ylim()[0] + 0.01 * (ax.get_ylim()[1] - ax.get_ylim()[0]),
        f'{max_temp_x:.1f}°C',
        color='firebrick', ha='left', va='bottom', fontsize=10, rotation=90)

# Guarda la figura en un archivo PNG. 
plt.savefig(
    "figura2.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
